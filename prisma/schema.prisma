// Qtable — multi-tenant QR-ordering platform.
// One deployment serves every outlet; every table below is scoped by cafeId.
// Postgres (Neon/Supabase/RDS) in production. Point DATABASE_URL at the pooler
// and DIRECT_URL at the direct connection for migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  provider     String   @default("password") // "password" | "google" — how the owner signs in
  verified     Boolean  @default(false) // email verified
  resetToken   String?  // password reset token
  resetExpires DateTime? // password reset token expiry
  role         String   @default("OWNER") // OWNER | STAFF | KITCHEN
  cafeId       String?
  cafe         Cafe?    @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]

  @@index([cafeId])
}

model Cafe {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  tagline      String   @default("Scan. Order. Enjoy.")
  description  String   @default("")
  currency     String   @default("INR")
  upiId        String   @default("")
  logoEmoji    String   @default("☕")
  primaryColor String   @default("#c2410c")
  // ---- Design studio theme (owner-customisable) ----
  themePrimary String   @default("#c2410c")
  themeAccent  String   @default("#f59e0b")
  themeBg      String   @default("#0c0a09")
  themeBgMode  String   @default("solid") // solid | gradient
  themePattern String   @default("none") // none | dots | grid | waves
  themeFont    String   @default("inter") // inter | playfair | poppins | dmserif | nunito | space
  themeRadius  String   @default("rounded") // rounded | soft | sharp
  themeStyle   String   @default("cards") // cards | editorial | list | poster | tickets
  themeImage   String   @default("") // optional uploaded brand photo used as menu backdrop
  themeWash    Int      @default(90) // backdrop overlay strength 50–98
  isActive     Boolean  @default(true)
  ownerId      String
  gstPct       Float    @default(5)
  // ---- Qtable subscription (per outlet) ----
  // New signups start "pending" (preview mode). Razorpay checkout/webhook flips
  // this to "active". Existing rows default to active so earlier deployments
  // and self-hosted installs keep working.
  planTier     String    @default("standard") // menu | standard | pro
  subStatus    String    @default("active") // pending | active | past_due | canceled
  subBilling   String    @default("monthly") // monthly | yearly
  subPaidUntil DateTime?
  subRef       String    @default("")
  subStartedAt DateTime?
  // ---- Self-serve Razorpay (per-outlet gateway, AES-encrypted at rest) ----
  razorpayKeyId        String  @default("")
  razorpayKeySecretEnc String  @default("")
  razorpayLive         Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users      User[]
  categories Category[]
  items      MenuItem[]
  tables     CafeTable[]
  orders     Order[]
  payments   Payment[]
  coupons    Coupon[]
  feedbacks  Feedback[]
  photos     MenuPhoto[]
  billing    BillingEvent[]
}

// Immutable money/lifecycle trail per outlet. Support can answer "did they
// pay?", the owner can see receipts, and the daily cron dedupes reminders.
model BillingEvent {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  kind      String // signup | activated | renewal | expired | reminder | canceled | refund
  plan      String   @default("")
  billing   String   @default("")
  amount    Int      @default(0) // paise
  ref       String   @default("")
  meta      String   @default("")
  createdAt DateTime @default(now())

  @@index([cafeId, createdAt])
  @@index([kind, createdAt])
}

// Built-in photo storage: used when no Vercel Blob token is configured, so the
// app is fully self-contained. Served through a cached public route.
model MenuPhoto {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String   @default("image/webp")
  createdAt DateTime @default(now())

  @@index([cafeId])
}

model Category {
  id     String @id @default(cuid())
  cafeId String
  cafe   Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name   String
  sort   Int    @default(0)

  items MenuItem[]

  // Public menu + dashboard builder read one outlet ordered by sort.
  @@index([cafeId, sort])
}

model MenuItem {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String   @default("")
  price       Int      // in paise (₹1 = 100)
  imageEmoji  String   @default("🍽️")
  imageUrl    String   @default("")
  veg         Boolean  @default(true)
  available   Boolean  @default(true)
  popular     Boolean  @default(false)
  sort        Int      @default(0)
  // ---- Inventory (Pro): null = untracked, otherwise live count ----
  stock       Int?
  lowAt       Int      @default(5)
  createdAt   DateTime @default(now())

  // Public menu, builder, and stock checks are all outlet-scoped.
  @@index([cafeId, sort])
  @@index([cafeId, categoryId, sort])
  @@index([cafeId, available])
}

model CafeTable {
  id      String  @id @default(cuid())
  cafeId  String
  cafe    Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  code    String  // T1, T2...
  name    String  @default("")
  qrToken String  @unique @default(cuid())
  active  Boolean @default(true)

  orders Order[]

  @@unique([cafeId, code])
}

model Order {
  id            String   @id @default(cuid())
  cafeId        String
  cafe          Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tableId       String?
  table         CafeTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableCode     String   @default("")
  tokenNo       Int      @default(0)
  tokenDay      String   @default("") // YYYY-MM-DD — scopes tokenNo uniqueness per day
  customerName  String   @default("Guest")
  customerPhone String   @default("")
  type          String   @default("DINEIN") // DINEIN | TAKEAWAY
  status        String   @default("NEW") // NEW ACCEPTED PREPARING READY SERVED COMPLETED CANCELLED
  paymentMode   String   @default("COUNTER") // COUNTER UPI ONLINE
  paymentStatus String   @default("PENDING") // PENDING PAID FAILED
  subtotal      Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  total         Int      @default(0)
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@unique([cafeId, tokenDay, tokenNo])
  // Live dashboard (status filter), order history, and queue-depth ETA.
  @@index([cafeId, status, createdAt])
  @@index([cafeId, createdAt])
  @@index([cafeId, updatedAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String @default("")
  name       String
  price      Int
  qty        Int    @default(1)
  note       String @default("")

  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode        String   // COUNTER UPI ONLINE
  status      String   @default("PENDING")
  amount      Int
  providerRef String   @default("")
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([cafeId, createdAt])
}

model Coupon {
  id     String  @id @default(cuid())
  cafeId String
  cafe   Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  code   String
  pct    Int     @default(10)
  active Boolean @default(true)

  @@unique([cafeId, code])
}

model Feedback {
  id        String   @id @default(cuid())
  cafeId    String
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orderId   String   @default("")
  rating    Int      @default(5)
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([cafeId, createdAt])
}

model ServiceCall {
  id        String   @id @default(cuid())
  cafeId    String
  tableCode String   @default("")
  status    String   @default("OPEN") // OPEN ACKNOWLEDGED RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cafeId, status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  cafeId    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  meta      String   @default("")
  createdAt DateTime @default(now())

  @@index([cafeId, createdAt])
  @@index([userId])
  @@index([createdAt])
}
