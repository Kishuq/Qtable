# Copy to .env and fill in
# Postgres pooler URL (Neon: Connect → Pooler, port 6543, ?sslmode=require).
# NOTE: DIRECT_URL is no longer used — schema reads DATABASE_URL only.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"
JWT_SECRET="use-openssl-rand-base64-48-min-32-chars"
# Encrypts per-outlet gateway secrets at rest (falls back to JWT_SECRET if unset)
PAYMENT_SECRET="use-openssl-rand-base64-32-min-32-chars"
# Public origin. On Vercel it can be omitted (VERCEL_PROJECT_PRODUCTION_URL is used).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Outlet payment gateways (optional fallback) ----
# Outlets normally connect their own Razorpay keys in Dashboard → Settings, and
# those are encrypted in the database. These env keys are only a deployment-wide
# fallback for a single-outlet install.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Qtable platform billing (self-serve subscriptions) ----
# YOUR Razorpay account — NOT an outlet's gateway keys. Used to create Orders for
# Basic / Standard / Pro checkout and to verify signatures in /api/billing/activate.
# Without these, /subscribe falls back to the hosted payment links below.
BILLING_RAZORPAY_KEY_ID=""
BILLING_RAZORPAY_KEY_SECRET=""
# HMAC secret for the Razorpay webhook pointed at /api/billing/webhook.
# Webhook events: payment.captured / order.paid (activation safety net),
# subscription.charged (receipt), subscription.halted (dunning).
BILLING_RAZORPAY_WEBHOOK_SECRET=""
# Optional hosted Razorpay payment-page links per plan (fallback only).
NEXT_PUBLIC_BILLING_MENU_URL=""
NEXT_PUBLIC_BILLING_STANDARD_URL=""
NEXT_PUBLIC_BILLING_PRO_URL=""

# ---- Email (Resend) ----
# Branded receipts, password resets and the Settings → Email delivery test.
RESEND_API_KEY=""
BILLING_EMAIL_FROM="Qtable Billing <billing@qtable.in>"
# Shown on /privacy, /terms and the landing footer. Use an inbox you actually read.
NEXT_PUBLIC_SUPPORT_EMAIL="support@qtable.in"

# ---- Subscription cron (required for automatic expiry + reminders) ----
# Vercel Cron calls /api/cron/billing daily with `Authorization: Bearer $CRON_SECRET`.
# Set the same random value here and in Vercel → Project → Environment Variables.
# Without it the route refuses every request (503/401), so it cannot be abused.
CRON_SECRET="use-openssl-rand-hex-24"

# ---- Rate limiting (optional) ----
# Distributed limits via Upstash Redis; memory fallback otherwise.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Crash reporting (optional) ----
# Set BOTH: SENTRY_DSN for the server, NEXT_PUBLIC_SENTRY_DSN for the browser.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# ---- Google signup / login (optional, recommended) ----
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Dish photos (optional) ----
# Unset = photos are stored in Postgres and served from /api/public/photo/[id]
# (no storage account needed). Set to use Vercel Blob instead.
BLOB_READ_WRITE_TOKEN=""
